NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use a secret/service_role key here. Do not use an sb_publishable_ key.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Meta Pixel and Conversions API.
NEXT_PUBLIC_META_PIXEL_ID=27312585481765745
META_CONVERSIONS_API_ACCESS_TOKEN=your-meta-conversions-api-access-token
META_GRAPH_API_VERSION=v24.0
# Optional: paste a Test Events code from Meta Events Manager while validating.
META_TEST_EVENT_CODE=

# Private leads dashboard at /leads.
LEADS_DASHBOARD_USER=admin
LEADS_DASHBOARD_PASSWORD=change-this-password
